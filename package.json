{
  "name": "classpoll-campus-platform",
  "version": "3.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p app/tsconfig.json",
    "test:unit": "node scripts/test-logic.mjs && node scripts/test-platform.mjs",
    "test:ui": "playwright test",
    "test:all": "npm run typecheck && npm run build && npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "vue": "3.5.18",
    "vue-router": "4.5.1",
    "@supabase/supabase-js": "2.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "6.0.0",
    "vite": "7.1.0",
    "typescript": "5.9.2",
    "vue-tsc": "3.0.5"
  }
}
